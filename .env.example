# Dodo Payments hosted checkout link. Dodo is a Merchant of Record and
# auto-detects the visitor's location, currency and local payment methods on
# its own hosted page, so this app shows the same single link to everyone -
# no region/gateway selection needed. Falls back to the link below (see
# src/config/dodo.ts) if this is left unset.
VITE_DODO_PAYMENT_LINK=https://dodo.pe/28i7y0cx8d8

# --- DISABLED: Razorpay + PayPal + EmailJS/Drive delivery (kept for reference) ---
# Replaced by Dodo Payments above. The code that reads these lives commented
# out in src/hooks/useRazorpayCheckout.ts, src/components/PayPalCheckoutButton.tsx,
# src/config/region.ts, src/hooks/usePricing.ts, src/pages/ThankYouPage.tsx,
# src/config/emailConfig.ts and src/lib/sendDeliveryEmail.ts. Uncomment here
# and there together to restore.
#
# Razorpay hosted Payment PAGE URL (India / INR checkout). Must be a live
# Payment Page URL (pages.razorpay.com/...) - NOT a Payment Link (rzp.io/...).
# VITE_RAZORPAY_PAYMENT_PAGE_URL=
#
# PayPal publishable Client ID (international / USD checkout).
# VITE_PAYPAL_CLIENT_ID=
#
# Google Drive file ID for the downloadable product (just the ID, not the
# full "view" URL).
# VITE_DRIVE_FILE_ID=
#
# EmailJS - delivered the download link by email after a PayPal purchase.
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
# --- END DISABLED ---
