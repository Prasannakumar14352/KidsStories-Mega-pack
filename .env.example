# SuperProfile hosted product/checkout link for the "Get Instant Access"
# button in the pricing card (India / INR checkout). If this is empty, the
# India button is disabled and shows "Payment temporarily unavailable"
# instead of failing silently.
#
# IMPORTANT: SuperProfile redirects after a successful payment are
# configured in the SuperProfile dashboard for this product (not from this
# app's code). Set that redirect URL to:
#   <your site URL>/thank-you
VITE_SUPERPROFILE_PAYMENT_URL=https://superprofile.bio/vp/kids-stories-189

# --- DISABLED: Razorpay (kept for reference - uncomment to re-enable) ---
# Also uncomment the matching block in src/config/region.ts (India entry).
# This MUST be a live Payment Page URL (pages.razorpay.com/...) - NOT a
# Payment Link (rzp.io/...). Razorpay redirects after a successful payment
# are configured on the Payment Page itself (Dashboard > Payment Pages >
# this page > enable "Redirect URL"), not from this app's code. Set that
# redirect URL to <your site URL>/thank-you.
# VITE_RAZORPAY_PAYMENT_PAGE_URL=https://rzp.io/rzp/kidsstories
# --- END DISABLED ---

# PayPal publishable Client ID (international / USD checkout). This is a
# public client ID, safe to expose in frontend code - never put a PayPal
# secret/client-secret in a VITE_* variable.
VITE_PAYPAL_CLIENT_ID=BAAy21EUjFRSrvBgDwesoqzg2wdQ0h-iDmue5gJKidOoAdkTIjyKpOjxyXtW5vD0C6lL-xyJaXVaaCvrUQ

# Google Drive file ID for the downloadable product - just the ID, not the
# full "view" URL (e.g. from https://drive.google.com/file/d/FILE_ID/view
# the ID is the FILE_ID segment). The app derives the real direct-download
# link from this automatically. This is NOT a secret - anyone who reaches
# /thank-you or reads the JS bundle can access the file. See the security
# comment above the delivery logic in src/pages/ThankYouPage.tsx.
VITE_DRIVE_FILE_ID=1thUp_cmbIYMevxNDtPZZnNqAQuHDDZNV

# EmailJS - delivers the download link by email after a PayPal purchase
# (Razorpay sends its own receipt, so this only fires for the PayPal path).
# Create a service + template in the EmailJS dashboard; the template should
# expect these params: to_email, download_url, product_name. The public key
# is safe to expose client-side, but restrict allowed origins and set rate
# limits in the EmailJS dashboard so it can't be abused for spam.
VITE_EMAILJS_SERVICE_ID=service_dw334bu
VITE_EMAILJS_TEMPLATE_ID=template_2qidl6d
VITE_EMAILJS_PUBLIC_KEY=eTrDNGok8LzhPKUqJ

